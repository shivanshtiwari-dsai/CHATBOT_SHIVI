# =================================================================
# SHIVI AI — ENVIRONMENT CONFIGURATION & API KEYS (EXAMPLE TEMPLATE)
# Copy this file to .env and insert your real API keys.
# =================================================================
# Port for the web server (default: 5500)
PORT=5500

# 🍃 MONGODB DATABASE CONFIGURATION
# Local MongoDB: mongodb://127.0.0.1:27017/shiviai_db
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/shiviai_db
MONGO_URI=mongodb://127.0.0.1:27017/shiviai_db

# 🔑 OAUTH CONFIGURATION (Google & GitHub)
# Google OAuth Client ID (Get at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# GitHub OAuth Client ID (Get at https://github.com/settings/developers)
GITHUB_CLIENT_ID=

# 🌟 GOOGLE GEMINI API KEY (100% Free - Recommended)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ⚡ GROQ CLOUD API KEY (100% Free & Ultra-Fast - Recommended)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# 🤖 OPENAI API KEY (For GPT-4o & DALL-E 3)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 🌐 OPENROUTER API KEY (Free & Paid models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 🖼️ DEDICATED IMAGE GENERATION API KEY (OpenAI DALL-E 3 / Stability AI / Hugging Face)
# Note: You can also use Pollinations.ai (100% Free with no key required!)
IMAGE_API_KEY=
IMAGE_PROVIDER=pollinations

# Default AI Provider to use: gemini | groq | openai | openrouter | builtin | auto
DEFAULT_PROVIDER=auto
