# ==========================================
# Git Ignore for Shivi AI
# ==========================================

# Environment variables & API keys
.env
.env.local
.env.*.local

# User data & credentials
users.json

# Node dependencies
node_modules/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Output directories & dynamic media
downloads/
generated_images/

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# System & IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
